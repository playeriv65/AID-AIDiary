# Optional Docker Compose overrides for authenticated presence and bounded relay.
# Daily budgets apply only when AID_SYNC_OPERATOR_LIMITS=true; self-hosted
# installations default to false. Frame and connection limits always apply.
AID_SYNC_NETWORK_SIGNAL_DAILY_BYTES=4194304
AID_SYNC_NETWORK_RELAY_DAILY_BYTES=33554432
AID_SYNC_NETWORK_SIGNAL_FRAME_BYTES=65536
AID_SYNC_NETWORK_RELAY_FRAME_BYTES=32768
AID_SYNC_NETWORK_MAX_PEERS=8
AID_SYNC_NETWORK_MAX_CONNECTIONS=16
