# Self-hosted storage is durable and unmetered by default.
# Official hosting must explicitly set AID_SYNC_OPERATOR_LIMITS=true.
# With operator limits enabled, all media limits below must be positive.
# Export these variables or place them in the deployment's local .env file.
AID_SYNC_OPERATOR_LIMITS=false
AID_SYNC_MONTHLY_MEDIA_BYTES=1000000000
AID_SYNC_MEDIA_MAX_OBJECT_BYTES=2097152
AID_SYNC_MEDIA_MAX_MANIFEST_BYTES=262144
AID_SYNC_MEDIA_CACHE_BYTES=134217728
AID_SYNC_MEDIA_DAILY_TRANSFER_BYTES=268435456
AID_SYNC_MEDIA_CACHE_TTL=168h
