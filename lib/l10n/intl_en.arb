  "helpFaq": "Frequently asked questions",
  "@helpFaq": {},
  "helpFaq1Q": "Where is my diary stored?",
  "@helpFaq1Q": {},
  "helpFaq1A": "Only on this device, in the app's own folder. Nothing is uploaded; there is no account.",
  "@helpFaq1A": {},
  "helpFaq2Q": "How do I keep a copy or move to a new device?",
  "@helpFaq2Q": {},
  "helpFaq2A": "Settings → Data & storage → Backup & Restore makes one file with entries, photos and settings, optionally with a password. Restore it on the new device. Backups can also run on a schedule.",
  "@helpFaq2A": {},
  "helpFaq3Q": "Can I bring in entries from other diary apps?",
  "@helpFaq3Q": {},
  "helpFaq3A": "Yes: in Settings → Data & storage, import exports from Daylio, Diarium, Diaro, DayBook, My Brain, OneShot and Pixels, or a JSON export.",
  "@helpFaq3A": {},
  "helpFaq4Q": "How do coach programs work?",
  "@helpFaq4Q": {},
  "helpFaq4A": "Enroll in a program on the Coach page. Each day or week a new question waits in Stories; your answer is saved as an entry.",
  "@helpFaq4A": {},
  "helpFaq5Q": "What if I forget my passcode?",
  "@helpFaq5Q": {},
  "helpFaq5A": "The passcode cannot be recovered, so keep a backup of your diary.",
  "@helpFaq5A": {},
