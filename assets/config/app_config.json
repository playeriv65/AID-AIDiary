{
  "map": {
    "tileUrlTemplate": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "attribution": "© OpenStreetMap contributors",
    "attributionUrl": "https://www.openstreetmap.org/copyright",
    "userAgentPackageName": "dev.aid.diary",
    "defaultZoom": 3.0,
    "entryZoom": 13.0,
    "maxZoom": 18.0,
    "clusterRadius": 56
  },
  "geocoding": {
    "reverseUrl": "https://nominatim.openstreetmap.org/reverse",
    "searchUrl": "https://nominatim.openstreetmap.org/search",
    "searchLimit": 6,
    "userAgent": "AID-Diary/1.0 (personal diary app)",
    "timeoutSeconds": 8
  },
  "location": {
    "timeoutSeconds": 15,
    "recentPlaces": 6
  },
  "nearby": {
    "url": "https://overpass-api.de/api/interpreter",
    "radiusMeters": 300,
    "limit": 12,
    "timeoutSeconds": 10
  },
  "diaryDay": {
    "lateNightUntilHour": 4
  },
  "typography": {
    "fontSizes": {"small": 14, "medium": 16, "large": 18, "extraLarge": 21},
    "lineSpacings": {"compact": 1.3, "normal": 1.5, "relaxed": 1.8},
    "fontFamilies": {
      "system": [],
      "serif": ["Noto Serif SC", "Source Han Serif SC", "Songti SC", "SimSun", "Noto Serif", "Georgia", "serif"],
      "mono": ["Cascadia Mono", "Consolas", "Noto Sans Mono", "Roboto Mono", "monospace"]
    }
  },
  "media": {
    "videoExtensions": [".mp4", ".mov", ".m4v", ".webm", ".mkv", ".3gp"],
    "audioExtensions": [".m4a", ".aac", ".mp3", ".wav", ".ogg", ".opus", ".flac"],
    "recordingExtension": ".m4a",
    "maxVideoMinutes": 5,
    "maxVideoMegabytes": 200
  },
  "routine": {
    "morningEndsHour": 11,
    "eveningStartsHour": 18
  },
  "coach": {
    "promptHour": 9
  },
  "nudges": {
    "afterDays": 3,
    "hour": 19
  },
  "recentlyDeleted": {
    "retentionDays": 30
  },
  "share": {
    "cardWidth": 380,
    "pixelRatio": 3.0,
    "maxCharacters": 900
  },
  "wallpaper": {
    "directory": "wallpaper",
    "photoScrimOpacity": 0.78,
    "patternSpacing": 24
  },
  "weather": {
    "forecastUrl": "https://api.open-meteo.com/v1/forecast",
    "archiveUrl": "https://archive-api.open-meteo.com/v1/archive",
    "recentDays": 60,
    "timeoutSeconds": 8,
    "attribution": "Weather data by Open-Meteo.com",
    "attributionUrl": "https://open-meteo.com/"
  },
  "photoWidget": {
    "candidates": 120
  },
  "launch": {
    "firstScreenEntries": 60
  }
}
