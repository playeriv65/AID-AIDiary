{
  "map": {
    "tileUrlTemplate": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "attribution": "© OpenStreetMap contributors",
    "attributionUrl": "https://www.openstreetmap.org/copyright",
    "userAgentPackageName": "dev.aid.diary",
    "defaultZoom": 3.0,
    "entryZoom": 13.0,
    "maxZoom": 18.0,
    "clusterRadius": 56,
    "rotationThreshold": 30.0,
    "northSnapDegrees": 15.0,
    "minWorldWidth": 0.5
  },
  "geocoding": {
    "reverseUrl": "https://nominatim.openstreetmap.org/reverse",
    "searchUrl": "https://nominatim.openstreetmap.org/search",
    "searchLimit": 6,
    "userAgent": "AID-Diary/1.0 (personal diary app)",
    "timeoutSeconds": 8
  },
  "location": {
    "timeoutSeconds": 15,
    "recentPlaces": 6
  },
  "nearby": {
    "url": "https://overpass-api.de/api/interpreter",
    "radiusMeters": 300,
    "limit": 12,
    "timeoutSeconds": 10
  },
  "scrolling": {
    "wheelDurationMs": 180,
    "backToTopScreens": 2,
    "backToTopSlideMs": 240,
    "backToTopScrollMs": 420
  },
  "feedback": {
    "issuesUrl": "https://github.com/playeriv65/AID-AIDiary/issues/new",
    "email": "playeriv65@gmail.com"
  },
  "diaryDay": {
    "startHourChoices": [0, 1, 2, 3, 4, 5, 6],
    "askUntilHourChoices": [0, 1, 2, 3, 4, 5, 6, 7, 8]
  },
  "typography": {
    "fontSizes": {"small": 14, "medium": 16, "large": 18, "extraLarge": 21},
    "lineSpacings": {"compact": 1.3, "normal": 1.5, "relaxed": 1.8},
    "fontFamilies": {
      "system": [],
      "serif": ["Noto Serif SC", "Source Han Serif SC", "Songti SC", "SimSun", "Noto Serif", "Georgia", "serif"],
      "mono": ["Cascadia Mono", "Consolas", "Noto Sans Mono", "Roboto Mono", "monospace"]
    }
  },
  "media": {
    "imageExtensions": [".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif", ".gif"],
    "videoExtensions": [".mp4", ".mov", ".m4v", ".webm", ".mkv", ".3gp"],
    "audioExtensions": [".m4a", ".aac", ".mp3", ".wav", ".ogg", ".opus", ".flac"],
    "recordingExtension": ".m4a",
    "maxVideoMinutes": 5,
    "maxVideoMegabytes": 200,
    "compressedPhotoBytes": 1000000,
    "compressedPhotoShortSide": 2048,
    "compressedPhotoQualities": [82, 75, 68, 60]
  },
  "routine": {
    "morningEndsHour": 11,
    "eveningStartsHour": 18
  },
  "coach": {
    "promptHour": 9
  },
  "nudges": {
    "afterDays": 3,
    "hour": 19
  },
  "recentlyDeleted": {
    "retentionDays": 30
  },
  "share": {
    "cardWidth": 380,
    "pixelRatio": 3.0,
    "maxCharacters": 900
  },
  "wallpaper": {
    "directory": "wallpaper",
    "photoScrimOpacity": 0.78,
    "patternSpacing": 24
  },
  "weather": {
    "forecastUrl": "https://api.open-meteo.com/v1/forecast",
    "archiveUrl": "https://archive-api.open-meteo.com/v1/archive",
    "recentDays": 60,
    "dayHour": 14,
    "timeoutSeconds": 8,
    "attribution": "Weather data by Open-Meteo.com",
    "attributionUrl": "https://open-meteo.com/"
  },
  "photoWidget": {
    "candidates": 120
  },
  "launch": {
    "firstScreenEntries": 60
  },
  "agentApi": {
    "port": 47819
  },
  "agent": {
    "baseUrl": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "maxTurns": 30,
    "outputChars": 16000,
    "sqlRows": 500,
    "acpAgents": {
      "claude": {
        "command": "npx",
        "args": ["-y", "@agentclientprotocol/claude-agent-acp"]
      },
      "codex": {
        "command": "npx",
        "args": ["-y", "@agentclientprotocol/codex-acp"],
        "env": {
          "CODEX_CONFIG": "{\"sandbox_workspace_write\":{\"network_access\":true}}"
        }
      },
      "gemini": {
        "command": "gemini",
        "args": ["--experimental-acp"]
      }
    }
  },
  "sync": {
    "afterChangeSeconds": 15,
    "whileOpenMinutes": 10,
    "packKiB": 16384,
    "compactAfterPacks": 20,
    "parallelTransfers": 3,
    "progressAfterSeconds": 3,
    "transfer": {
      "nearbyInvitationSeconds": 120,
      "nearbySessionSeconds": 3600,
      "nearbyPackKiB": 1024,
      "chunkKiB": 1024,
      "cacheMaxFileMiB": 16,
      "cacheTransferMiB": 32,
      "relayMaxFileKiB": 256,
      "relayTransferMiB": 2,
      "stunUrls": ["stun:stun.cloudflare.com:3478"],
      "retryBaseSeconds": 15,
      "retryMaxSeconds": 600,
      "probeTimeoutSeconds": 4,
      "reprobeSeconds": 30,
      "minimumDwellSeconds": 15,
      "switchImprovement": 0.2,
      "mdnsType": "_aid-diary._tcp"
    },
    "officialServer": "https://aid.playeriv65.com/dav/",
    "exampleServer": "https://dav.jianguoyun.com/dav/",
    "googleDrive": {
      "webClientId": "878450224701-e57hp1g6uspj5dj6tl1h6hhe9hs62oi1.apps.googleusercontent.com",
      "desktopClientId": "878450224701-4u26iifrceddjmq2si01lrsa54rjjl40.apps.googleusercontent.com",
      "desktopClientSecret": "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",
      "authUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "apiUrl": "https://www.googleapis.com/drive/v3/",
      "uploadUrl": "https://www.googleapis.com/upload/drive/v3/",
      "signInTimeoutMinutes": 5
    },
    "recovery": {
      "codeBytes": 20,
      "minPasswordLength": 12,
      "argon2MemoryKiB": 65536,
      "argon2Iterations": 3
