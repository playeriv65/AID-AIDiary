# ============================================================
# AI API Configuration (Google Gemini API - OpenAI compatible format)
# ============================================================
# Required: Your Google Gemini API key for AI features
API_KEY=
# API base URL (default: Google Gemini OpenAI-compatible endpoint)
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI model name (default: gemini-3.1-flash-lite-preview)
MODEL_NAME=gemini-3.1-flash-lite-preview

# ============================================================
# Mem0 Memory Service Configuration
# ============================================================
# Mem0 service URL (default: http://localhost:8888)
MEM0_API_URL=http://localhost:8888
# Required: Google API key for Mem0 memory service
GOOGLE_API_KEY=

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
# Required: Full PostgreSQL connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# ============================================================
# Application Security
# ============================================================
# Required: JWT secret key for token signing
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ============================================================
# JWT Configuration
# ============================================================
# Access token expiration time (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token expiration time (days)
REFRESH_TOKEN_EXPIRE_DAYS=7
