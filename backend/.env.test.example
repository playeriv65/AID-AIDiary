# AID-AIDiary Test Environment Configuration Template
#
# This is a TEMPLATE file for test environment configuration.
# DO NOT commit your real .env.test file to git - it should be added to .gitignore.
#
# How to use this file:
# 1. Copy this file to create a .env.test file: `cp .env.test.example .env.test`
# 2. Replace placeholder values with REAL test credentials
# 3. Test-specific configs will override these values where needed
#
# For testing purposes, you may use:
# - In-memory SQLite: DATABASE_URL=sqlite:///:memory:
# - Mock API keys: API_KEY=test-key, SECRET_KEY=test-secret
# - Local mem0: MEM0_API_URL=http://localhost:8888 (for integration tests)

# AI API Configuration for Testing (Google Gemini API - OpenAI compatible format)
# How to get API Key: Create an account at https://aistudio.google.com/ and generate an API key
API_KEY=your-api-key-here
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemini-3.1-flash-lite-preview

# Server Configuration
# Internal port the server listens on (inside container)
PORT=8000
# External port exposed to host (to avoid conflicts with production)
EXPOSED_PORT=8001

# Mem0 Memory Service Configuration (used for test integration - keep off for unit tests)
# Requires GOOGLE_API_KEY for memory extraction. See: https://aistudio.google.com/apikey
MEM0_API_URL=http://localhost:8888
GOOGLE_API_KEY=your-google-api-key-here

# Database for Testing
# SQLite in-memory is often used for unit tests, but can be set to persist for integration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_aidiary

# App Security for Testing
# Should be different from production. Value can be generated with: openssl rand -hex 32
SECRET_KEY=your-jwt-secret-for-testing