# This computer's toolchain for scripts/dev.ps1. Copy to scripts/dev.env
# (ignored by git) and set the paths; docs/SETUP.md lists the versions.

# Required.
FLUTTER_ROOT=C:\tools\flutter
PUB_CACHE=C:\tools\pub-cache
JAVA_HOME=C:\tools\jdk-23
ANDROID_HOME=C:\tools\android-sdk
# Rust (rustup) for the agent's shell in rust/.
RUSTUP_HOME=C:\tools\rust\rustup
CARGO_HOME=C:\tools\rust\cargo

# Optional: leave empty for the tools' own defaults.
ANDROID_USER_HOME=
ANDROID_AVD_HOME=
GRADLE_USER_HOME=
# Temp folder for Flutter's builds and test runs, off a small system drive.
DEV_TEMP=
# One permanent runtime directory, shared by worktrees. Used by windows-stage.
# Keep scratch diary data elsewhere. The first launch may need firewall consent.
DEV_WINDOWS_RUNTIME=
